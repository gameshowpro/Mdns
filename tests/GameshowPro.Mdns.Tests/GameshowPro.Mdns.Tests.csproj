<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(Configuration)' != 'DebugWindows' And '$(Configuration)' != 'ReleaseWindows'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(Configuration)' == 'DebugWindows' Or '$(Configuration)' == 'ReleaseWindows'">net10.0-windows</TargetFramework>
    <EnableWindowsTargeting Condition="'$(Configuration)' == 'DebugWindows' Or '$(Configuration)' == 'ReleaseWindows'">true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GameshowPro.Mdns/GameshowPro.Mdns.csproj" />
  </ItemGroup>
</Project>
